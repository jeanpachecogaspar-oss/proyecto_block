{
    "name": "quipu/quipu-noticias",
    "description": "Quipu Noticias: blog de noticias autoadministrable en PHP 8 y MySQL (Producto Académico N.º 2 - Pruebas y Calidad de Software).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Quipu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quipu\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "sort-packages": true
    }
}
